@PACKAGE_INIT@

# KRS Graphics installed package. The Vulkan loader is resolved at RUNTIME by
# the vendored volk (dlopen/LoadLibrary), and the allocator/headers are
# compiled into the library — consumers need no Vulkan SDK and no third-party
# find_dependency calls (ADR-003).

include("${CMAKE_CURRENT_LIST_DIR}/KRSGraphicsTargets.cmake")

check_required_components(KRSGraphics)
